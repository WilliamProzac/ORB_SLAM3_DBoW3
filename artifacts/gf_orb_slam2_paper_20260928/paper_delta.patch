+void Bucket::erase(const Entry e)
+{
+    std::unique_lock<std::mutex> lock(mMutexBucket);
+    auto it = std::find(mEntries.begin(), mEntries.end(), e);
+    if (it != mEntries.end()) mEntries.erase(it);
+    mLatest = mEntries.empty() ? nullptr : mEntries.front();
+    mIter = mEntries.begin();
+}
