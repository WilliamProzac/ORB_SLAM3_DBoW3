+Entry Bucket::touch(const Entry e, size_t capacity)
+{
+    if (!capacity) throw std::invalid_argument("zero bucket capacity");
+    std::unique_lock<std::mutex> lock(mMutexBucket);
+    // Capacity is fixed for the lifetime of this index, not a per-call budget.
+    if (mEntries.size() > capacity) throw std::logic_error("capacity changed");
+    auto old = std::find(mEntries.begin(), mEntries.end(), e);
+    if (old != mEntries.end()) mEntries.erase(old);
+    mEntries.push_front(e);
+    Entry evicted = nullptr;
+    if (mEntries.size() > capacity) {
+        evicted = mEntries.back();
+        mEntries.pop_back();
     }
+    mLatest = mEntries.front();
+    mIter = mEntries.begin();
+    return evicted;
+}
 
