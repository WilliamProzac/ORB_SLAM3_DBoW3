+// Reverse membership exists only while a point occupies at least one bucket.
+// It is bounded by the number of stored entries, not total historical MPs.
+bool MultiIndexHashing::insertRecentLocked(Entry feature, const std::vector<size_t>& buckets)
+{
+    const size_t absent = bucket_num_per_hashtable;
+    auto previous = mLocations.find(feature);
+    if (previous != mLocations.end()) {
+        ++mDiagnostics.refreshes;
+        for (size_t k=0; k<hashtable_num; ++k) {
+            if (previous->second[k] != absent && previous->second[k] != buckets[k]) {
+                mvvBuckets[k][previous->second[k]].erase(feature);
+                previous->second[k] = absent;
+                ++mDiagnostics.migrations;
+            }
+        }
+    }
+    auto& location = mLocations.emplace(feature, std::vector<size_t>(hashtable_num, absent)).first->second;
+    for (size_t k=0; k<hashtable_num; ++k) {
+        Entry evicted = mvvBuckets[k][buckets[k]].touch(feature, max_feature_num_per_bucket);
+        location[k] = buckets[k];
+        if (evicted) {
+            ++mDiagnostics.evictions;
+            auto old = mLocations.find(evicted);
+            if (old == mLocations.end()) throw std::logic_error("missing reverse membership");
+            old->second[k] = absent;
+            if (std::all_of(old->second.begin(), old->second.end(), [absent](size_t x){return x==absent;}))
+                mLocations.erase(old);
+        }
+    }
+    return true;
+}
+
+MultiIndexHashing::Diagnostics MultiIndexHashing::diagnostics()
+{
+    std::unique_lock<std::mutex> lock(mMutexUpdate);
+    Diagnostics d = mDiagnostics;
+    d.indexed_points = mLocations.size();
+    for (auto& table : mvvBuckets) for (auto& bucket : table) {
+        size_t n = bucket.size();
+        d.entries += n;
+        d.max_bucket = std::max(d.max_bucket, n);
+    }
+    return d;
+}
